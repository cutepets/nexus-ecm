# =========================================================================
# Nexus ECM — Environment Variables (copy to .env and replace every sample value)
# Values in this file are development examples and must never be used on a VPS.
# =========================================================================

# ---- App ----
NODE_ENV=development
APP_DOMAIN=app.example.com
PROXY_NETWORK=n8n_net
API_PORT=4100
WEB_PORT=3100
API_URL=http://localhost:4100
WEB_URL=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:4100/api/v1

# ---- Database (PostgreSQL) ----
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_password
POSTGRES_DB=nexus_ecm
POSTGRES_PORT=5440
DATABASE_URL=postgresql://nexus:nexus_password@localhost:5440/nexus_ecm?schema=public

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---- JWT ----
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Swagger is enabled by default in development and disabled in production.
ENABLE_SWAGGER=false

# ---- MinIO (S3-compatible object storage) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=nexus-files

# ---- File storage provider ----
# MINIO remains the default and is needed to read files that have not been migrated.
STORAGE_PROVIDER=MINIO
# Google Drive OAuth credentials and folder ID are configured in Settings > Storage.

# ---- Mail (MailHog in dev) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Nexus ECM <no-reply@nexus.local>"

# ---- Face Recognition ----
# 32-byte (64 hex chars) key used to encrypt face embeddings at rest (AES-256-GCM).
FACE_ENCRYPTION_KEY=change-me-64-hex-chars-0000000000000000000000000000000000000000
FACE_MATCH_THRESHOLD=0.55

# ---- Security ----
THROTTLE_TTL=60
THROTTLE_LIMIT=100
CORS_ORIGIN=http://localhost:3100
# Production assumes one trusted reverse proxy in front of the API.
TRUST_PROXY_HOPS=1
# Set true and mount a licensed GeoLite2 Country .mmdb to enforce Vietnam-only access.
GEOIP_COUNTRY_FILTER_ENABLED=false

# ---- Seed (initial super admin) ----
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@nexus.local
SEED_ADMIN_PASSWORD=Admin123! # development only; replace before any production deployment
