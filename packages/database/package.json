{
  "name": "@nexus/database",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/src/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "generate": "prisma generate --schema=./schema.prisma",
    "migrate": "prisma migrate dev --schema=./schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema=./schema.prisma",
    "studio": "prisma studio --schema=./schema.prisma",
    "seed": "tsx seed.ts",
    "format": "prisma format --schema=./schema.prisma"
  },
  "prisma": {
    "seed": "tsx seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "argon2": "^0.41.1",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
