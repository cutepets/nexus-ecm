// =============================================================================
// Nexus ECM — Prisma Schema  (PostgreSQL)
// Version 1.0
//
// Conventions:
//   - cuid() primary keys (string).
//   - createdAt/updatedAt on mutable entities.
//   - Soft delete via `deletedAt` where history must be retained.
//   - Money stored as Decimal(18,2). Currency stored alongside where relevant.
//   - All file fields hold MinIO object keys / URLs.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// 1. IDENTITY, RBAC, AUDIT, NOTIFICATIONS
// =============================================================================

model User {
  id                 String    @id @default(cuid())
  username           String    @unique
  email              String    @unique
  phone              String?   @unique
  passwordHash       String
  fullName           String
  avatarUrl          String?
  avatarPortraitUrl  String?
  avatarCropUrl      String?
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  employee       Employee?
  roles          UserRole[]
  refreshTokens  RefreshToken[]
  auditLogs      AuditLog[]
  notifications  Notification[]
  documentsOwned Folder[]
  documentShares DocumentShare[]
  conversations  ConversationMember[]
  messages       Message[]
  mentions       MessageMention[]
  announcements  Announcement[]
  docOwned       Document[]
  docVersions    DocumentVersion[]

  @@index([email])
  @@map("users")
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique // ADMIN, HR, MANAGER, EMPLOYEE, or custom
  description String?
  isSystem    Boolean @default(false)

  users       UserRole[]
  permissions RolePermission[]
  assignmentRules RoleAssignmentRule[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. "employee:create", "attendance:report:read"
  module      String
  description String?

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  userId String
  roleId String
  isAutomatic Boolean @default(false)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RoleAssignmentRule {
  id           String   @id @default(cuid())
  name         String
  departmentId String?
  positionId   String?
  branchId     String?
  roleId       String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([roleId])
  @@index([departmentId, positionId, branchId, isActive])
  @@map("role_assignment_rules")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  deviceInfo String?
  ip         String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  EXPORT
}

model AuditLog {
  id        String      @id @default(cuid())
  actorId   String?
  action    AuditAction
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  createdAt DateTime    @default(now())
  actor     User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  data      Json?
  channel   NotificationChannel @default(IN_APP)
  isRead    Boolean             @default(false)
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

/// Singleton company-wide configuration. The fixed id `default` keeps this
/// deployment ready for future tenant support without needing a lookup today.
model CompanySetting {
  id           String   @id @default("default")
  companyName  String   @default("Nexus ECM")
  logoKey      String?
  locale       String   @default("vi-VN")
  timezone     String   @default("Asia/Ho_Chi_Minh")
  currency     String   @default("VND")
  weekStartsOn Int      @default(1) // 0 = Sunday, 1 = Monday
  requireGps       Boolean @default(true)
  livenessMode     LivenessMode @default(RANDOM)
  faceMatchThreshold Float @default(0.55)
  faceDuplicateThreshold Float @default(0.43)
  auditRetentionDays Int @default(90)
  rosterAutoGenerateEnabled Boolean @default(true)
  rosterGenerationDay Int @default(20)
  employmentTypes String[] @default(["VAN_PHONG", "CUA_HANG_POS", "CONG_TRUONG", "TU_XA", "CA_KIP"])
  payrollMode PayrollMode @default(MONTHLY)
  workUnitMode WorkUnitMode @default(DAILY)
  payrollCutoffDay Int @default(25)
  timesheetStartDay Int @default(26)
  timesheetEndDay Int @default(25)
  roundingMinutes Int @default(15)
  latePenaltyPerMinute Decimal @default(0) @db.Decimal(18, 2)
  missingPunchPenalty Decimal @default(0) @db.Decimal(18, 2)
  overtimeTriggerMinutes Int @default(15)
  overtimeMultiplier Float @default(1.5)
  integrationApiEnabled Boolean @default(false)
  integrationAllowedOrigins String[] @default([])
  trustedWebOrigins String[] @default(["https://chamcong.petshophanoi.com"])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("company_settings")
}

enum LivenessMode {
  NONE
  BLINK
  TURN_HEAD
  RANDOM
  SMILE
  THUMB_UP
  PEACE
}

enum PayrollMode {
  MONTHLY
  HOURLY
  SHIFT
  HYBRID
}

enum WorkUnitMode {
  DAILY
  HOURLY
}

model Branch {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  address       String?
  latitude      Float
  longitude     Float
  radiusMeters  Int      @default(100)
  isActive      Boolean  @default(true)
  displayOrder  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  locations     BranchLocation[]
  assignments   EmployeeBranchAssignment[]
  rosterSegments EmployeeDailyScheduleSegment[]
  primaryEmployees Employee[] @relation("PrimaryEmployeeBranch")

  @@index([isActive, displayOrder])
  @@map("branches")
}

model BranchLocation {
  id          String   @id @default(cuid())
  branchId    String
  code        String   @unique
  name        String
  address     String?
  latitude    Float
  longitude   Float
  radiusMeters Int     @default(100)
  allowRemote Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  checkIns    Attendance[] @relation("CheckInLocation")
  checkOuts   Attendance[] @relation("CheckOutLocation")

  @@index([branchId, isActive])
  @@map("branch_locations")
}

// =============================================================================
// 2. EMPLOYEE / HR
// =============================================================================

enum WorkStatus {
  PROBATION
  PERMANENT
  CONTRACT
  ON_LEAVE
  INACTIVE
}

model Department {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  managerId String?
  createdAt DateTime @default(now())

  positions   Position[]
  employees   Employee[]    @relation("DeptEmployees")
  jobHistory  JobHistory[]

  @@map("departments")
}

model Position {
  id           String     @id @default(cuid())
  title        String
  departmentId String
  level        Int        @default(1)
  department   Department @relation(fields: [departmentId], references: [id])

  employees  Employee[]
  jobHistory JobHistory[]

  @@map("positions")
}

model Employee {
  id           String     @id @default(cuid())
  userId       String     @unique
  employeeNo   String     @unique
  fullName     String
  jobTitle     String     @default("Nhân viên")
  photoUrl     String?
  email        String?
  phone        String?
  address      String?
    gender       String?
    dateOfBirth  DateTime?
    identityCode String?    @unique
    emergencyContactName  String?
    emergencyContactPhone String?
    taxCode      String?
    salaryBankName    String?
    salaryBankAccount String?
  basicSalary       Decimal?  @db.Decimal(18, 2)
  spaBonusPercent   Decimal?  @db.Decimal(5, 2)
  employmentType    EmploymentType @default(FULL_TIME)
  primaryBranchId   String?
  departmentId String?
  positionId   String?
  managerId    String?
  workStatus   WorkStatus @default(PROBATION)
  joinDate     DateTime
  exitDate     DateTime?
  terminatedAt DateTime?
  terminationReason String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  department Department? @relation("DeptEmployees", fields: [departmentId], references: [id])
  position   Position?   @relation(fields: [positionId], references: [id])
  primaryBranch Branch? @relation("PrimaryEmployeeBranch", fields: [primaryBranchId], references: [id])
  manager    Employee?   @relation("EmployeeManager", fields: [managerId], references: [id])
  reports    Employee[]  @relation("EmployeeManager")

  jobHistory     JobHistory[]
  salaryHistory  SalaryHistory[]
  employmentHistory EmploymentHistory[]
  documents      EmployeeDocument[]
  faceProfiles   FaceProfile[]
  attendances    Attendance[]
  leaveRequests  LeaveRequest[]
  leaveApprovals LeaveApproval[]
  leaveBalances  LeaveBalance[]
  projectMembers ProjectMember[]
  taskAssignees  TaskAssignee[]
  taskComments   TaskComment[]
  branchAssignments EmployeeBranchAssignment[]
  workScheduleAssignments EmployeeWorkScheduleAssignment[]
  workScheduleOverrides EmployeeScheduleOverride[]
  dailySchedules EmployeeDailySchedule[]
  timesheetEntries TimesheetEntry[]
  attendanceCorrectionRequests AttendanceCorrectionRequest[]
  overtimeRequests AttendanceOvertimeRequest[]

  @@index([departmentId])
  @@index([primaryBranchId])
  @@index([fullName])
  @@map("employees")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
}

model EmployeeBranchAssignment {
  id            String   @id @default(cuid())
  employeeId    String
  branchId      String
  effectiveFrom DateTime @db.Date
  effectiveTo   DateTime? @db.Date
  allowRemote   Boolean  @default(false)
  createdAt     DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([employeeId, branchId, effectiveFrom])
  @@index([employeeId, effectiveFrom, effectiveTo])
  @@map("employee_branch_assignments")
}

model JobHistory {
  id           String     @id @default(cuid())
  employeeId   String
  positionId   String?
  departmentId String?
  startDate    DateTime
  endDate      DateTime?
  note         String?
  employee     Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  position     Position?   @relation(fields: [positionId], references: [id])
  department   Department? @relation(fields: [departmentId], references: [id])

  @@index([employeeId])
  @@map("job_history")
}

model SalaryHistory {
  id            String   @id @default(cuid())
  employeeId    String
  amount        Decimal  @db.Decimal(18, 2)
  currency      String   @default("IDR")
  effectiveDate DateTime
  reason        String?
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("salary_history")
}

/// A durable employment milestone for changes to the employee's long-term terms.
/// Daily roster edits remain in the roster tables and do not create these records.
model EmploymentHistory {
  id             String   @id @default(cuid())
  employeeId     String
  effectiveDate  DateTime @db.Date
  changeType     String
  reason         String?
  decisionNumber String?
  changes        Json
  createdById    String?
  createdAt      DateTime @default(now())

  employee  Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  documents EmployeeDocument[]

  @@index([employeeId, effectiveDate])
  @@map("employment_history")
}

enum EmployeeDocType {
  KTP
  NPWP
  CV
  CONTRACT
  OTHER
}

enum DocVerifyStatus {
  PENDING
  VERIFIED
  REJECTED
}

model EmployeeDocument {
  id         String          @id @default(cuid())
  employeeId String
  docType    EmployeeDocType
  fileUrl    String
  fileName   String
  status     DocVerifyStatus @default(PENDING)
  uploadedAt DateTime        @default(now())
  historyId  String?
  employee   Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  history    EmploymentHistory? @relation(fields: [historyId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([historyId])
  @@map("employee_documents")
}

// =============================================================================
// 3. ATTENDANCE & FACE RECOGNITION
// =============================================================================

model FaceProfile {
  id             String   @id @default(cuid())
  employeeId     String
  embedding      Bytes // serialized Float32Array (128/512-d)
  quality        Float    @default(0)
  sampleImageUrl String?
  isPrimary      Boolean  @default(false)
  createdAt      DateTime @default(now())
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("face_profiles")
}

enum AttendanceStatus {
  PRESENT
  LATE
  LEAVE
  PERMIT
  ABSENT
}

enum AttendanceApprovalStatus {
  APPROVED
  PENDING
  REJECTED
}

enum AttendanceExceptionType {
  OUTSIDE_GEOFENCE
  WRONG_SCHEDULE
  FACE_UNRECOGNIZED
  GPS_UNAVAILABLE
  MISSED_PUNCH
  LATE_ARRIVAL
  OTHER
}

model Attendance {
  id              String           @id @default(cuid())
  employeeId      String
  workDate        DateTime         @db.Date
  checkInAt       DateTime?
  checkOutAt      DateTime?
  checkInLat      Float?
  checkInLng      Float?
  checkOutLat     Float?
  checkOutLng     Float?
  checkInPhotoUrl String?
  checkOutPhotoUrl String?
  checkInLocationId String?
  checkOutLocationId String?
  checkInAccuracyMeters Float?
  checkOutAccuracyMeters Float?
  checkInDistanceMeters Float?
  checkOutDistanceMeters Float?
  geofenceReason String?
  deviceInfo      Json?
  matchScore      Float?
  livenessPassed  Boolean          @default(false)
  livenessChallenge String?
  livenessPolicy  LivenessMode?
  approvalStatus AttendanceApprovalStatus @default(APPROVED)
  exceptionType AttendanceExceptionType?
  approvalRequestNote String?
  approvalUpdate     Json?
  approvalEvidencePhotoUrls String[] @default([])
  manualWorkScheduleId String?
  manualWorkScheduleName String?
  latePenaltyWaived  Boolean          @default(false)
  approvalReviewedAt DateTime?
  approvalReviewedById String?
  approvalReviewNote String?
  status          AttendanceStatus @default(ABSENT)
  createdAt       DateTime         @default(now())
  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  sessions        AttendanceSession[]
  overtimeRequests AttendanceOvertimeRequest[]
  checkInLocation BranchLocation? @relation("CheckInLocation", fields: [checkInLocationId], references: [id], onDelete: SetNull)
  checkOutLocation BranchLocation? @relation("CheckOutLocation", fields: [checkOutLocationId], references: [id], onDelete: SetNull)

  @@unique([employeeId, workDate])
  @@index([workDate])
  @@index([checkInLocationId])
  @@index([approvalStatus, workDate])
  @@map("attendances")
}

model AttendanceSession {
  id                    String   @id @default(cuid())
  attendanceId          String
  sequence              Int
  checkInAt             DateTime
  checkOutAt            DateTime?
  checkInLocationId     String?
  checkOutLocationId    String?
  checkInPhotoUrl       String?
  checkOutPhotoUrl      String?
  checkInLat            Float?
  checkInLng            Float?
  checkOutLat           Float?
  checkOutLng           Float?
  checkInAccuracyMeters Float?
  checkOutAccuracyMeters Float?
  checkInDistanceMeters Float?
  checkOutDistanceMeters Float?
  checkOutUpdateCount   Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@unique([attendanceId, sequence])
  @@index([attendanceId, checkInAt])
  @@map("attendance_sessions")
}

model WorkSchedule {
  id           String @id @default(cuid())
  name         String @unique
  startTime    String // "08:00"
  endTime      String // "17:00"
  secondStartTime String? // optional second segment, e.g. "17:00"
  secondEndTime   String? // optional second segment, e.g. "22:00"
  displayOrder Int    @default(0)

  assignments EmployeeWorkScheduleAssignment[]
  overrides   EmployeeScheduleOverride[]
  dailySchedules EmployeeDailySchedule[]

  @@index([displayOrder])
  @@map("work_schedules")
}

enum DailyScheduleSource {
  GENERATED
  MANAGER_EDITED
  SHIFT_CHANGE_APPROVED
}

model WorkRosterMonth {
  id            String           @id @default(cuid())
  monthStart    DateTime         @unique @db.Date
  generatedAt   DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  dailySchedules EmployeeDailySchedule[]

  @@map("work_roster_months")
}

model EmployeeDailySchedule {
  id             String              @id @default(cuid())
  rosterMonthId  String
  employeeId     String
  workDate       DateTime            @db.Date
  workScheduleId String
  scheduleName   String
  source         DailyScheduleSource @default(GENERATED)
  note           String?
  createdById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  rosterMonth  WorkRosterMonth @relation(fields: [rosterMonthId], references: [id], onDelete: Cascade)
  employee     Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workSchedule WorkSchedule    @relation(fields: [workScheduleId], references: [id], onDelete: Restrict)
  segments     EmployeeDailyScheduleSegment[]

  @@unique([employeeId, workDate])
  @@index([rosterMonthId, workDate])
  @@map("employee_daily_schedules")
}

model EmployeeDailyScheduleSegment {
  id              String   @id @default(cuid())
  dailyScheduleId String
  branchId        String
  sequence        Int
  startTime       String
  endTime         String

  dailySchedule EmployeeDailySchedule @relation(fields: [dailyScheduleId], references: [id], onDelete: Cascade)
  branch        Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@unique([dailyScheduleId, sequence])
  @@index([branchId])
  @@map("employee_daily_schedule_segments")
}

enum ScheduleOverrideSource {
  MANAGER_OVERRIDE
  SHIFT_CHANGE_APPROVED
}

/// A one-day schedule takes precedence over a recurring assignment without
/// rewriting that employee's normal weekly schedule.
model EmployeeScheduleOverride {
  id             String                 @id @default(cuid())
  employeeId     String
  workDate       DateTime               @db.Date
  workScheduleId String
  source         ScheduleOverrideSource @default(MANAGER_OVERRIDE)
  requestId      String?
  note           String?
  createdById    String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workSchedule WorkSchedule @relation(fields: [workScheduleId], references: [id], onDelete: Restrict)

  @@unique([employeeId, workDate])
  @@index([workDate])
  @@index([workScheduleId])
  @@map("employee_schedule_overrides")
}

/// An effective-dated schedule assignment. An empty `weekdays` value means
/// every day; otherwise values follow JavaScript's convention (0 = Sunday).
model EmployeeWorkScheduleAssignment {
  id             String   @id @default(cuid())
  employeeId     String
  workScheduleId String
  effectiveFrom  DateTime @db.Date
  effectiveTo    DateTime? @db.Date
  weekdays       Int[]    @default([])
  priority       Int      @default(0)
  note           String?
  createdAt      DateTime @default(now())

  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workSchedule WorkSchedule @relation(fields: [workScheduleId], references: [id], onDelete: Restrict)

  @@unique([employeeId, workScheduleId, effectiveFrom])
  @@index([employeeId, effectiveFrom, effectiveTo])
  @@index([workScheduleId])
  @@map("employee_work_schedule_assignments")
}

enum AttendanceCorrectionStatus {
  PENDING
  NEEDS_MORE_INFO
  APPROVED
  REJECTED
}

enum AttendanceCorrectionAction {
  CREATED
  UPDATED
  REQUESTED_MORE_INFO
  APPROVED
  REJECTED
}

/// Immutable request for a missing or incorrect punch; the original
/// attendance record is preserved and the approved change is auditable.
model AttendanceCorrectionRequest {
  id              String   @id @default(cuid())
  employeeId      String
  attendanceId    String?
  workDate        DateTime @db.Date
  proposedCheckIn DateTime?
  proposedCheckOut DateTime?
  reason          String
  evidencePhotoUrl String?
  evidencePhotoUrls String[] @default([])
  status          AttendanceCorrectionStatus @default(PENDING)
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNote      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  history  AttendanceCorrectionHistory[]

  @@index([employeeId, workDate, status])
  @@map("attendance_correction_requests")
}

/// Append-only record of each employee amendment and each manager decision.
model AttendanceCorrectionHistory {
  id          String                     @id @default(cuid())
  requestId   String
  action      AttendanceCorrectionAction
  actorId     String?
  note        String?
  snapshot    Json?
  createdAt   DateTime                   @default(now())

  request AttendanceCorrectionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("attendance_correction_history")
}

enum AttendanceOvertimeStatus {
  PENDING
  APPROVED
  REJECTED
}

model AttendanceOvertimeRequest {
  id           String   @id @default(cuid())
  attendanceId String
  employeeId   String
  requestedMinutes Int
  reason       String
  status       AttendanceOvertimeStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime @default(now())

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([attendanceId])
  @@index([employeeId, status])
  @@map("attendance_overtime_requests")
}

enum TimesheetPeriodStatus {
  DRAFT
  REVIEW
  LOCKED
}

model TimesheetPeriod {
  id          String   @id @default(cuid())
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  status      TimesheetPeriodStatus @default(DRAFT)
  lockedAt    DateTime?
  lockedById  String?
  reopenedAt  DateTime?
  reopenedById String?
  reopenReason String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries TimesheetEntry[]

  @@unique([startDate, endDate])
  @@index([status, startDate])
  @@map("timesheet_periods")
}

model TimesheetEntry {
  id                String   @id @default(cuid())
  periodId          String
  employeeId        String
  workDate          DateTime @db.Date
  attendanceId      String?
  scheduledMinutes  Int      @default(0)
  workedMinutes     Int      @default(0)
  roundedWorkMinutes Int     @default(0)
  workUnits         Decimal  @default(0) @db.Decimal(10, 4)
  lateMinutes       Int      @default(0)
  earlyLeaveMinutes Int      @default(0)
  latePenalty       Decimal  @default(0) @db.Decimal(18, 2)
  missingPunch      Boolean  @default(false)
  missingPunchPenalty Decimal @default(0) @db.Decimal(18, 2)
  overtimeMinutes   Int      @default(0)
  overtimeApprovedMinutes Int @default(0)
  sourceSnapshot    Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  period    TimesheetPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee  Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([periodId, employeeId, workDate])
  @@index([employeeId, workDate])
  @@map("timesheet_entries")
}

/// A scoped credential for a system-to-system integration. The plaintext key
/// is returned exactly once at creation; only its SHA-256 digest is persisted.
model IntegrationApiKey {
  id         String    @id @default(cuid())
  name       String
  keyPrefix  String    @unique
  secretHash String    @unique
  scopes     String[]
  branchIds  String[]  @default([])
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdById String?
  createdAt  DateTime  @default(now())

  kpiEvents          IntegrationKpiEvent[]
  idempotencyRecords IntegrationIdempotencyRecord[]

  @@index([revokedAt, expiresAt])
  @@map("integration_api_keys")
}

/// An immutable KPI/point-of-sale input accepted from a scoped integration.
/// `externalId` makes upstream retries safe independently of HTTP transport.
model IntegrationKpiEvent {
  id           String   @id @default(cuid())
  apiKeyId     String
  externalId   String
  employeeId   String
  branchId     String
  occurredAt   DateTime
  salesAmount  Decimal  @default(0) @db.Decimal(18, 2)
  orderCount   Int      @default(0)
  currency     String   @default("VND")
  payload      Json?
  createdAt    DateTime @default(now())

  apiKey IntegrationApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Restrict)

  @@unique([apiKeyId, externalId])
  @@index([employeeId, occurredAt])
  @@index([branchId, occurredAt])
  @@map("integration_kpi_events")
}

/// Retains a successful POST response for replay of the same Idempotency-Key.
model IntegrationIdempotencyRecord {
  id             String   @id @default(cuid())
  apiKeyId       String
  endpoint       String
  idempotencyKey String
  requestHash    String
  response       Json
  createdAt      DateTime @default(now())

  apiKey IntegrationApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@unique([apiKeyId, endpoint, idempotencyKey])
  @@index([createdAt])
  @@map("integration_idempotency_records")
}

/// Configurable POS/KPI fields applied to the `payload` of KPI events.
model IntegrationKpiField {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  fieldType   String   @default("NUMBER") // NUMBER | TEXT | BOOLEAN
  required    Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("integration_kpi_fields")
}

enum IntegrationWebhookDeliveryStatus {
  PENDING
  DELIVERED
  DEAD_LETTER
}

/// A server-to-server webhook target. Its signing secret is encrypted at rest
/// and returned only at creation time.
model IntegrationWebhookSubscription {
  id               String   @id @default(cuid())
  url              String
  eventTypes       String[] @default([])
  secretCiphertext Bytes
  isActive         Boolean  @default(true)
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  deliveries IntegrationWebhookDelivery[]

  @@index([isActive])
  @@map("integration_webhook_subscriptions")
}

/// Durable retry/dead-letter log for outbound integration events.
model IntegrationWebhookDelivery {
  id             String                           @id @default(cuid())
  subscriptionId String
  eventType      String
  payload        Json
  status         IntegrationWebhookDeliveryStatus @default(PENDING)
  attempts       Int                              @default(0)
  nextAttemptAt  DateTime                         @default(now())
  lastStatusCode Int?
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime                         @default(now())
  updatedAt      DateTime                         @updatedAt

  subscription IntegrationWebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@map("integration_webhook_deliveries")
}

// =============================================================================
// 4. LEAVE MANAGEMENT
// =============================================================================

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

model LeaveType {
  id           String  @id @default(cuid())
  name         String // Cuti, Izin, Sakit
  defaultQuota Int     @default(12)
  requiresDoc  Boolean @default(false)

  requests LeaveRequest[]
  balances LeaveBalance[]

  @@map("leave_types")
}

model LeaveRequest {
  id          String      @id @default(cuid())
  employeeId  String
  leaveTypeId String
  startDate   DateTime    @db.Date
  endDate     DateTime    @db.Date
  reason      String
  documentUrl String?
  status      LeaveStatus @default(PENDING)
  currentStep Int         @default(1)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  employee  Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType       @relation(fields: [leaveTypeId], references: [id])
  approvals LeaveApproval[]

  @@index([employeeId])
  @@index([status])
  @@map("leave_requests")
}

model LeaveApproval {
  id             String           @id @default(cuid())
  leaveRequestId String
  step           Int // 1=Supervisor, 2=Manager, 3=HR
  role           String // SUPERVISOR | MANAGER | HR
  approverId     String?
  decision       ApprovalDecision @default(PENDING)
  comment        String?
  decidedAt      DateTime?
  leaveRequest   LeaveRequest     @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  approver       Employee?        @relation(fields: [approverId], references: [id])

  @@index([leaveRequestId])
  @@map("leave_approvals")
}

model LeaveBalance {
  id          String    @id @default(cuid())
  employeeId  String
  leaveTypeId String
  year        Int
  allocated   Int       @default(0)
  used        Int       @default(0)
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

// =============================================================================
// 5. PROJECTS & TASKS
// =============================================================================

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

model Project {
  id            String        @id @default(cuid())
  name          String
  code          String        @unique
  description   String?
  status        ProjectStatus @default(PLANNING)
  startDate     DateTime?
  deadline      DateTime?
  progress      Int           @default(0)
  budgetPlanned Decimal       @default(0) @db.Decimal(18, 2)
  budgetActual  Decimal       @default(0) @db.Decimal(18, 2)
  managerId     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  milestones Milestone[]
  tasks      Task[]
  members    ProjectMember[]

  @@index([status])
  @@map("projects")
}

model Milestone {
  id        String   @id @default(cuid())
  projectId String
  title     String
  dueDate   DateTime?
  completed Boolean  @default(false)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@index([projectId])
  @@map("milestones")
}

model ProjectMember {
  projectId  String
  employeeId String
  role       String?
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([projectId, employeeId])
  @@map("project_members")
}

model Task {
  id          String       @id @default(cuid())
  projectId   String?
  milestoneId String?
  title       String
  description String?
  priority    TaskPriority @default(MEDIUM)
  status      TaskStatus   @default(TODO)
  dueDate     DateTime?
  orderIndex  Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project     Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  milestone   Milestone?       @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  assignees   TaskAssignee[]
  checklist   ChecklistItem[]
  comments    TaskComment[]
  attachments TaskAttachment[]

  @@index([projectId])
  @@index([status])
  @@map("tasks")
}

model TaskAssignee {
  taskId     String
  employeeId String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([taskId, employeeId])
  @@map("task_assignees")
}

model ChecklistItem {
  id         String  @id @default(cuid())
  taskId     String
  label      String
  done       Boolean @default(false)
  orderIndex Int     @default(0)
  task       Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("checklist_items")
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    Employee @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_comments")
}

model TaskAttachment {
  id         String   @id @default(cuid())
  taskId     String
  fileUrl    String
  fileName   String
  uploadedAt DateTime @default(now())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("task_attachments")
}

// =============================================================================
// 9. DOCUMENTS
// =============================================================================

enum DocType {
  SOP
  CONTRACT
  INVOICE
  LETTER
  OTHER
}

enum ShareAccess {
  VIEW
  EDIT
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  ownerId   String?
  createdAt DateTime @default(now())
  parent    Folder?  @relation("FolderTree", fields: [parentId], references: [id])
  children  Folder[] @relation("FolderTree")
  owner     User?    @relation(fields: [ownerId], references: [id])
  documents Document[]

  @@map("folders")
}

model Document {
  id               String   @id @default(cuid())
  folderId         String?
  title            String
  docType          DocType  @default(OTHER)
  currentVersionId String?
  ownerId          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  folder   Folder?           @relation(fields: [folderId], references: [id])
  owner    User?             @relation(fields: [ownerId], references: [id])
  versions DocumentVersion[]
  shares   DocumentShare[]

  @@index([folderId])
  @@map("documents")
}

model DocumentVersion {
  id           String   @id @default(cuid())
  documentId   String
  version      Int
  fileUrl      String
  fileName     String
  sizeBytes    Int      @default(0)
  uploadedById String?
  uploadedAt   DateTime @default(now())
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])

  @@unique([documentId, version])
  @@map("document_versions")
}

model DocumentShare {
  id               String      @id @default(cuid())
  documentId       String
  sharedWithUserId String
  access           ShareAccess @default(VIEW)
  document         Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  sharedWith       User        @relation(fields: [sharedWithUserId], references: [id], onDelete: Cascade)

  @@unique([documentId, sharedWithUserId])
  @@map("document_shares")
}

// =============================================================================
// 10. INTERNAL COMMUNICATION
// =============================================================================

enum ConversationType {
  DIRECT
  GROUP
}

enum AnnouncementAudience {
  ALL
  DEPARTMENT
  ROLE
}

model Conversation {
  id          String           @id @default(cuid())
  type        ConversationType
  name        String?
  createdById String?
  createdAt   DateTime         @default(now())

  members  ConversationMember[]
  messages Message[]

  @@map("conversations")
}

model ConversationMember {
  conversationId String
  userId         String
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("conversation_members")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime     @default(now())
  editedAt       DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  attachments MessageAttachment[]
  mentions    MessageMention[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model MessageAttachment {
  id        String  @id @default(cuid())
  messageId String
  fileUrl   String
  fileName  String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_attachments")
}

model MessageMention {
  messageId String
  userId    String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@map("message_mentions")
}

model Announcement {
  id          String               @id @default(cuid())
  authorId    String
  title       String
  body        String
  audience    AnnouncementAudience @default(ALL)
  targetRef   String? // departmentId or roleId when scoped
  publishedAt DateTime             @default(now())
  author      User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("announcements")
}
